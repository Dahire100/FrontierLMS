# Backend Environment Variables Template
# Copy this file to .env and fill in the values

PORT=5000
NODE_ENV=production

# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# JWT Configuration
JWT_SECRET=<generate-a-strong-random-string-64-chars>
JWT_EXPIRES_IN=17d

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Frontier LMS" <your-email@gmail.com>

# Super Admin
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# Frontend URL (for CORS - REQUIRED in production)
FRONTEND_URL=https://your-frontend-domain.com

# Loki Logging Configuration
# Provide your Loki endpoint URL here (e.g., from Grafana Cloud or a self-hosted Loki)
# LOKI_HOST=http://your-loki-domain:3100
